+/* Opaque key blobs are implementation-private (MSDN: importable only into the
+ * CSP that exported them). Wine only needs them to round-trip within Wine, so we
+ * serialize the fullest standard blob for the key, tagged with a small id that
+ * import uses to recover the inner blob type. */
+#define BCRYPT_WINE_OPAQUE_TAG 0x4b504f57 /* 'WOPK' */
+
+static ULONG opaque_inner_id( const WCHAR *type )
+{
+    if (!wcscmp( type, BCRYPT_RSAFULLPRIVATE_BLOB )) return 1;
+    if (!wcscmp( type, BCRYPT_RSAPUBLIC_BLOB ))      return 2;
+    if (!wcscmp( type, BCRYPT_ECCPRIVATE_BLOB ))     return 3;
+    if (!wcscmp( type, BCRYPT_ECCPUBLIC_BLOB ))      return 4;
+    if (!wcscmp( type, BCRYPT_DSA_PRIVATE_BLOB ))    return 5;
+    if (!wcscmp( type, BCRYPT_DSA_PUBLIC_BLOB ))     return 6;
+    if (!wcscmp( type, BCRYPT_DH_PRIVATE_BLOB ))     return 7;
+    if (!wcscmp( type, BCRYPT_DH_PUBLIC_BLOB ))      return 8;
+    return 0;
 }
 
+static const WCHAR *opaque_inner_type( ULONG id )
+{
+    switch (id)
+    {
+    case 1: return BCRYPT_RSAFULLPRIVATE_BLOB;
+    case 2: return BCRYPT_RSAPUBLIC_BLOB;
+    case 3: return BCRYPT_ECCPRIVATE_BLOB;
+    case 4: return BCRYPT_ECCPUBLIC_BLOB;
+    case 5: return BCRYPT_DSA_PRIVATE_BLOB;
+    case 6: return BCRYPT_DSA_PUBLIC_BLOB;
+    case 7: return BCRYPT_DH_PRIVATE_BLOB;
+    case 8: return BCRYPT_DH_PUBLIC_BLOB;
+    default: return NULL;
+    }
+}
