+            inner = (key->flags & KEY_FLAG_PRIVATE) ? BCRYPT_RSAFULLPRIVATE_BLOB : BCRYPT_RSAPUBLIC_BLOB;
+            break;
+        case ALG_ID_DH:
+            inner = (key->flags & KEY_FLAG_PRIVATE) ? BCRYPT_DH_PRIVATE_BLOB : BCRYPT_DH_PUBLIC_BLOB;
+            break;
+        case ALG_ID_DSA:
+            inner = (key->flags & KEY_FLAG_PRIVATE) ? BCRYPT_DSA_PRIVATE_BLOB : BCRYPT_DSA_PUBLIC_BLOB;
+            break;
+        case ALG_ID_ECDH:
+        case ALG_ID_ECDH_P256:
+        case ALG_ID_ECDH_P384:
+        case ALG_ID_ECDH_P521:
+        case ALG_ID_ECDSA:
+        case ALG_ID_ECDSA_P256:
+        case ALG_ID_ECDSA_P384:
+        case ALG_ID_ECDSA_P521:
+            inner = (key->flags & KEY_FLAG_PRIVATE) ? BCRYPT_ECCPRIVATE_BLOB : BCRYPT_ECCPUBLIC_BLOB;
